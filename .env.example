# copy to .env and fill in — .env is gitignored
# Slack incoming webhook for #trade-post alerts (run_alert.py / slack_plan.py)
SLACK_WEBHOOK_URL=

# Polygon.io API key for real-time option chains (optional; falls back to yfinance)
POLYGON_API_KEY=

# Schwab Trader API — free real-time for account holders (register at developer.schwab.com)
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1
